# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API Keys). For local dev, `supabase status` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS — used only by background jobs and the seed script.
SUPABASE_SECRET_KEY=

# First admin recruiter, created by `npm run db:seed`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# Optional: point `npm run test:db` at a Supabase stack. The tests create and
# delete their own orgs and users. Never point this at production.
# Non-local URLs are refused unless TEST_ALLOW_REMOTE_DB=1 (a dedicated test project).
# TEST_SUPABASE_URL=
# TEST_SUPABASE_PUBLISHABLE_KEY=
# TEST_SUPABASE_SECRET_KEY=
# TEST_ALLOW_REMOTE_DB=

# LLM and embedding settings are added in Milestone 6.
